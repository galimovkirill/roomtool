set -e

# Frontend: lint + format staged files
echo "▶ frontend: lint-staged…"
pnpm --filter frontend exec lint-staged

# Frontend: typecheck
echo "▶ frontend: typecheck…"
pnpm --filter frontend run typecheck

# Frontend: tests
echo "▶ frontend: tests…"
pnpm --filter frontend run test:run

# Backend: vet + test (only if Go files are staged)
if git diff --cached --name-only | grep -q '\.go$'; then
  echo "▶ backend: vet…"
  (cd apps/backend && go vet ./...)
  echo "▶ backend: test…"
  (cd apps/backend && go test ./...)
fi
